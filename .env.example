# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# FalkorDB (docker compose up -d). Use 127.0.0.1, not localhost: on Windows localhost tries IPv6
# first and the first query waits ~21 s before falling back.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
GRAPH_NAME=flowtrace

# Claude, for the investigation agent and reports. Without a key the agent runs its rule-based
# policy and stats.policy says "heuristic fallback".
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
