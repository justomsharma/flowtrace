# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# FalkorDB (docker compose up -d). Use 127.0.0.1, not localhost: on Windows localhost tries IPv6
# first and the first query waits ~21 s before falling back.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
GRAPH_NAME=flowtrace

# LLM for the investigation agent and reports. Without a working key the agent runs its rule-based
# policy and stats.policy says "heuristic fallback".
# LLM_PROVIDER: openai (default) or anthropic. AGENT_MODEL empty = the provider's default
# (openai: gpt-6-luna, anthropic: claude-sonnet-5-5).
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=
